/*
 * spinko-sosho keymap for the Elekit SO-SHO TH-601 (44-key split with L-trackpad, R-trackball).
 * Translated from justindwyer6/qmk_firmware keyboards/lets_split/keymaps/spinko/keymap.c.
 */

#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <input/processors/zmk-input-processor-keybind.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

#define QWERTY  0
#define NAV     1
#define NPAD    2
#define SYM     3
#define POINTER 4
#define CLICK   5

/ {
    behaviors {
        // Layer-tap for D/F/J/K home-row keys.
        // Hold enters the CLICK layer; tap types the letter.
        // tap-preferred + require-prior-idle-ms prevents accidental clicks during fast typing.
        clicklt: click_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        // Shift+Backspace -> Delete. Cmd/Ctrl/Alt+Backspace stays as real
        // Backspace so Cmd+Bspc still deletes lines / Opt+Bspc still deletes
        // words on macOS.
        bsdel: bsdel {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Encoder-driven horizontal / vertical scroll (used on POINTER layer).
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };

    // Convert trackpad motion into arrow key presses.
    // Order matters: RIGHT (X+), LEFT (X-), UP (Y+), DOWN (Y-).
    // - `threshold` sets how much motion must accumulate before firing a key.
    // - `tick` throttles repeats when motion continues.
    // Tune these later if arrows fire too often or too rarely.
    trackpad_arrows: trackpad_arrows {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;
        bindings = <&kp RIGHT>, <&kp LEFT>, <&kp UP>, <&kp DOWN>;
        tick = <60>;
        wait-ms = <0>;
        tap-ms = <10>;
        mode = <1>;
        threshold = <40>;
        max_threshold = <200>;
        max_pending_activations = <10>;
    };
};

&msc {
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Base QWERTY. D/F/J/K are hold-taps into CLICK layer.
            // Thumb row (row 3): outer=ENTER, inner-outer=Ctrl/Esc, then Shift,
            // then innermost=Cmd/Space -- matches the original spinko layout.
            bindings = <
&lt NAV DEL    &kp Q       &kp W  &kp E              &kp R              &kp T          &kp Y  &kp U              &kp I              &kp O         &kp P          &bsdel
&kp TAB        &kp A       &kp S  &clicklt CLICK D   &clicklt CLICK F   &kp G          &kp H  &clicklt CLICK J   &clicklt CLICK K   &kp L         &lt NAV SEMI   &kp TAB
&lt SYM GRAVE  &lt NPAD Z  &kp X  &kp C              &kp V              &kp B          &kp N  &kp M              &kp COMMA          &mt RALT DOT  &lt NPAD FSLH  &lt SYM SQT
&kp ENTER      &mt LCTRL ESC                         &kp LSHFT          &mt LGUI SPACE     &mt RGUI SPACE         &kp RSHFT                       &mt RCTRL BSLH &kp ENTER
            >;

            // Left encoder = brightness, Right encoder = volume.
            sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP  &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        nav_layer {
            // spinko _NAV: arrows on right home row, media/brightness/volume on left, page-nav on inner columns.
            // OPPOSIT/MOUSE references collapsed (OPPOSIT dropped, MOUSE becomes POINTER toggle).
            bindings = <
&tog NAV      &kp LG(LSHFT)   &kp LA(LSHFT)    &kp UP           &kp LA(LGUI)     &kp C_VOL_UP    &kp PG_UP  &kp RCTRL  &kp UP        &kp RCTRL  &trans   &kp BSPC
&trans        &kp LCTRL       &mt LALT LEFT    &mt LSHFT DOWN   &mt LGUI RIGHT   &kp C_VOL_DN    &kp PG_DN  &kp LEFT   &kp DOWN      &kp RIGHT  &trans   &kp DEL
&kp C_BRI_DN  &kp C_BRI_UP    &mt LALT C_PREV  &kp C_NEXT       &mt LALT C_PP    &kp C_MUTE      &kp RGUI   &kp RALT   &tog POINTER  &kp RALT   &kp ESC  &kp TAB
&kp BSPC      &trans                                            &trans           &trans          &trans     &trans                                &trans   &trans
            >;
        };

        npad_layer {
            // spinko _NPAD.
            bindings = <
&tog NPAD  &trans  &kp N7  &kp N8  &kp N9  &kp BSPC    &trans  &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC
&trans     &trans  &kp N4  &kp N5  &kp N6  &kp DOT     &trans  &kp N4  &kp N5  &kp N6  &trans  &kp DEL
&trans     &trans  &kp N1  &kp N2  &kp N3  &kp N0      &kp N0  &kp N1  &kp N2  &kp N3  &trans  &kp TAB
&kp BSPC   &trans                          &trans      &trans  &trans                          &trans  &trans
            >;
        };

        sym_layer {
            // spinko _SYM.
            bindings = <
&tog SYM  &kp GRAVE  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR    &trans  &kp AMPS  &kp STAR   &kp LPAR   &kp RPAR   &kp BSPC
&trans    &kp EQUAL  &kp DLLR   &kp PRCNT  &kp CARET  &trans      &trans  &kp DLLR  &kp PRCNT  &kp CARET  &kp COLON  &kp GRAVE
&trans    &kp MINUS  &kp EXCL   &kp AT     &kp HASH   &trans      &trans  &kp EXCL  &kp AT     &kp HASH   &kp QMARK  &kp TAB
&kp BSPC  &trans                          &kp LBKT    &trans      &trans  &kp RBKT                                   &kp PIPE   &trans
            >;
        };

        pointer_layer {
            // Pointing device / Bluetooth / output tuning.
            // Encoders switch to horizontal (L) and vertical (R) scroll here.
            bindings = <
&tog POINTER  &trans          &trans  &trans  &trans  &trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_BLE
&trans        &trans          &trans  &trans  &trans  &trans      &trans        &mkp LCLK     &mkp MCLK     &mkp RCLK     &trans        &out OUT_USB
&bt BT_CLR    &bt BT_CLR_ALL  &trans  &trans  &trans  &trans      &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans                          &trans  &trans      &trans        &trans                                    &trans        &trans
            >;

            sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT  &ec_ms_r SCRL_DOWN SCRL_UP>;
        };

        click_layer {
            // Target of the &clicklt hold on D/F/J/K.
            // Only the four "opposite-finger" positions produce clicks; everything else is transparent.
            //   K held -> J pos = LCLK  (middle->index roll = left click)
            //   J held -> K pos = RCLK  (index->middle roll = right click)
            //   D held -> F pos = LCLK  (same on the left hand)
            //   F held -> D pos = RCLK
            // While this layer is active, the trackpad and trackball also
            // convert motion into scroll (see input-listener overrides below).
            bindings = <
&trans  &trans  &trans  &trans      &trans      &trans    &trans  &trans      &trans      &trans  &trans  &trans
&trans  &trans  &trans  &mkp RCLK   &mkp LCLK   &trans    &trans  &mkp LCLK   &mkp RCLK   &trans  &trans  &trans
&trans  &trans  &trans  &trans      &trans      &trans    &trans  &trans      &trans      &trans  &trans  &trans
&trans  &trans                      &trans      &trans    &trans  &trans                          &trans  &trans
            >;
        };
    };
};

// Turn the trackball (right, on-central) into a scroll wheel while the
// CLICK layer is active. Hold D/F/J/K, move the ball -> scroll.
// The 1/3 scaler is applied before conversion so scroll steps are ~1/3
// as fast as normal cursor motion (trackball is quite sensitive by default).
&trackball_listener {
    scroll_on_click {
        layers = <CLICK>;
        input-processors = <&zip_xy_scaler 1 5>, <&zip_xy_to_scroll_mapper>;
    };
};

// Trackpad (left, forwarded via split) is repurposed as a directional
// gesture pad: swipe right/left/up/down -> arrow key. The keybind
// processor consumes the X/Y motion, so no cursor motion is emitted.
&glidepoint_split_listener {
    input-processors = <&trackpad_arrows>;
};
